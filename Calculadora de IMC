#include<stdio.h>
#include<string.h>
int main(){
    float peso, altura, imc;
    char sexo;
    printf("Digite seu sexo (M,F): \n");
    scanf("%c",&sexo);
    printf("Digite o peso(Kg): \n");
    scanf("%f",&peso);
    printf("Digite a altura(M): \n");
    scanf("%f",&altura);
    imc=peso/(altura*altura);
    printf("seu IMC e: %.2f\n",imc);
    switch(sexo){
        case'M':
        if(imc<20.7)
        printf("Classificacao: abaixo do peso\n");
        else if(imc>=20.7 && imc<=26.4)
        printf("Clasificacao: peso normal\n");
        else if(imc>=25 && imc<=27.8)
        printf("Classificacao: sobrepeso\n");
        else if(imc>=27.8 && imc<=31.1)
        printf("Classificacao: Obesidade grau I\n");
        else if(imc>=31.1 && imc<=40)
        printf("Classificacao: Obesidade grau II\n");
        else
        printf("Classificao: Obesidade grau III(morbida)\n");
        break;
        case'F':
        if(imc<19.1)
        printf("Classificacao: abaixo do peso\n");
        else if(imc>=19.1 && imc<=25.8)
        printf("Classificacao: peso normal\n");
        else if(imc>=25.8 && imc<=27.3)
        printf("Classificacao: sobrepeso\n");
        else if(imc>=27.3 && imc<=32.3)+
        printf("Classificacao: Obsidade grau I\n");
        else if(imc>=32.3 && imc<=40)
        printf("Classificacao: Obesidade grau II\n");
        else
        printf("Classificacao: Obsidade grau III(morbida)\n");
        break;
        default:
        printf("ERRO!\n");
    }
    return 0;
}    
